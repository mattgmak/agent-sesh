# direnv integration for devenv — https://devenv.sh/automatic-shell-activation/
#
# This direnv build (2.37.1) does not ship the `use devenv` stdlib function
# (devenv support landed upstream in direnv 2.32 but is absent here), so source
# the rc that defines it from the devenv CLI. Requires `devenv` on PATH.
source_up

export NIX_CONFIG="substituters = https://cache.nixos.org https://devenv.cachix.org
trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw="

eval "$(devenv direnvrc)"
# direnv activation is non-interactive; disable devenv's live TUI.
use devenv --no-tui
